# ===============================================================
# 安全红线：以下文件含真实服务器信息或客户端私钥，绝不能提交
# 注意：.gitignore 不支持行尾注释，注释必须单独成行
# ===============================================================

# 保存过的主机 / 端口 / 用户名 / 私钥路径
connections.json

# SSH 主机指纹
known_hosts

# 导出的客户端 .conf（内含客户端私钥）
clients/

# 任何 WireGuard 配置，含私钥
*.conf

# 日志
*.log
error.log
selftest.log

# ===============================================================
# 依赖与构建产物（可由 requirements 重装 / 重新打包）
# ===============================================================

vendor/
.build-venv/
build/
dist/
__pycache__/
*.py[cod]
*.egg-info/

# PyInstaller 首次命令行打包自动生成的冗余 spec（权威配置是 wireguard-manager.spec）
WireGuard密钥管理工具.spec

# 官方客户端安装包：7 MB 二进制，不进仓库。
# 打包时由 build_assets/fetch_wireguard_msi.py 下载（会校验 Authenticode 签名），
# 或者手动放进 build_assets/。没有它安装包只是少了「同时装客户端」选项。
build_assets/wireguard-amd64-*.msi

# 打包时由 build_assets/stamp_version.py 生成，内容随每次构建变化
version.txt

# 验证用的原始截图（4MB BMP，仓库里只留压缩后的 PNG）
build_assets/*.bmp

# 调试过程中生成的临时截图，没有文档用途
build_assets/app_preview.png
build_assets/dl_dialog.png
build_assets/exe_v2.png
build_assets/exe_v3.png
build_assets/qr_demo.png
build_assets/qr_dialog.png

# ===============================================================
# 编辑器 / 系统垃圾
# ===============================================================

.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# 客户端配置保险箱：存的是加密后的客户端私钥，绝对不能进仓库
clients.vault.json
clients.vault.json.tmp

# 本地配置历史：含服务器私钥的 wg0.conf 快照，同样不能进仓库
history/

# 操作审计日志：含服务器地址和密钥名，属于运行数据
audit.jsonl
audit.jsonl.*

# 流量采样库
traffic.db
traffic.db-journal

# 界面偏好（托盘 / 自启 / 刷新间隔）
settings.json
